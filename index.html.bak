<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Screenshot to Code | Made by Lumi</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Theme change indicator -->
    <div class="theme-indicator" id="themeIndicator">☀️ Light mode enabled</div>

    <div class="app">
        <header class="header">
            <div class="logo">
                <span class="logo-icon">💡</span>
                <span class="logo-text">Screenshot to Code</span>
            </div>
            <nav class="nav">
                <button id="themeToggle" class="nav-btn" title="Toggle Dark Mode">🌙</button>
                <a href="https://github.com/Agent-Lumi/screenshot-to-code" class="nav-btn" title="View on GitHub">📎</a>
            </nav>
        </header>

        <main class="main">
            <section class="upload-section" id="uploadSection">
                <div class="upload-zone" id="uploadZone">
                    <div class="upload-icon">📸</div>
                    <h2>Drop a screenshot here</h2>
                    <p>or paste (Ctrl+V), click to upload, or drag & drop</p>
                    <input type="file" id="fileInput" accept="image/*" hidden>
                    <div class="upload-formats">
                        <span>Supports: PNG, JPG, WebP, GIF</span>
                    </div>
                </div>
            </section>

            <section class="preview-section" id="previewSection" hidden>
                <div class="preview-header">
                    <h3>Original Image</h3>
                    <button class="btn btn-secondary" id="newUploadBtn">📤 New Image</button>
                </div>
                <div class="preview-container">
                    <img id="previewImage" alt="Screenshot preview">
                </div>
            </section>

            <section class="options-section" id="optionsSection" hidden>
                <h3>Generate Options</h3>
                <div class="options-grid">
                    <label class="option-card">
                        <input type="radio" name="outputType" value="html" checked>
                        <span class="option-icon">🌐</span>
                        <span class="option-title">HTML/CSS</span>
                        <span class="option-desc">Semantic HTML with modern CSS</span>
                    </label>
                    <label class="option-card">
                        <input type="radio" name="outputType" value="react">
                        <span class="option-icon">⚛️</span>
                        <span class="option-title">React Component</span>
                        <span class="option-desc">JSX with styled-components</span>
                    </label>
                    <label class="option-card">
                        <input type="radio" name="outputType" value="vue">
                        <span class="option-icon">🟢</span>
                        <span class="option-title">Vue Component</span>
                        <span class="option-desc">Single File Component</span>
                    </label>
                    <label class="option-card">
                        <input type="radio" name="outputType" value="tailwind">
                        <span class="option-icon">🌊</span>
                        <span class="option-title">Tailwind CSS</span>
                        <span class="option-desc">Utility-first classes</span>
                    </label>
                </div>
                
                <div class="options-extra">
                    <label class="checkbox-label">
                        <input type="checkbox" id="includeResponsive" checked>
                        <span>Include responsive design</span>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" id="includeComments">
                        <span>Add explanatory comments</span>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" id="extractColors" checked>
                        <span>Extract color palette</span>
                    </label>
                </div>

                <!-- API Integration Section -->
                <div class="api-section" id="apiSection">
                    <h4 class="api-section-title">🔗 AI API Integration (Optional)</h4>
                    <p class="api-section-desc">Connect to an AI service for real screenshot-to-code conversion</p>
                    
                    <div class="api-provider-select">
                        <label class="api-option">
                            <input type="radio" name="apiProvider" value="none" checked>
                            <span class="api-option-content">
                                <span class="api-icon">🎲</span>
                                <span class="api-info">
                                    <span class="api-name">Mock/Demo Mode</span>
                                    <span class="api-desc">Generate sample code without API</span>
                                </span>
                            </span>
                        </label>
                        <label class="api-option">
                            <input type="radio" name="apiProvider" value="openai">
                            <span class="api-option-content">
                                <span class="api-icon">🤖</span>
                                <span class="api-info">
                                    <span class="api-name">OpenAI GPT-4 Vision</span>
                                    <span class="api-desc">Requires API key for real conversion</span>
                                </span>
                            </span>
                        </label>
                        <label class="api-option">
                            <input type="radio" name="apiProvider" value="anthropic">
                            <span class="api-option-content">
                                <span class="api-icon">🧠</span>
                                <span class="api-info">
                                    <span class="api-name">Anthropic Claude</span>
                                    <span class="api-desc">Requires API key for real conversion</span>
                                </span>
                            </span>
                        </label>
                        <label class="api-option">
                            <input type="radio" name="apiProvider" value="ollama">
                            <span class="api-option-content">
                                <span class="api-icon">🦙</span>
                                <span class="api-info">
                                    <span class="api-name">Ollama (Local)</span>
                                    <span class="api-desc">Free local AI - requires Ollama running</span>
                                </span>
                            </span>
                        </label>
                    </div>
                    
                    <div class="api-config" id="apiConfig" hidden>
                        <div class="api-input-group">
                            <label for="apiKey">API Key:</label>
                            <div class="api-key-wrapper">
                                <input type="password" id="apiKey" placeholder="Enter your API key" autocomplete="off">
                                <button type="button" id="toggleApiKey" title="Show/Hide">👁️</button>
                            </div>
                        </div>
                        <div class="api-input-group" id="apiUrlGroup" hidden>
                            <label for="apiUrl">Ollama URL:</label>
                            <input type="url" id="apiUrl" placeholder="http://localhost:11434" value="http://localhost:11434">
                        </div>
                        <div class="api-actions">
                            <button type="button" class="btn btn-secondary" id="saveApiKey">💾 Save Key (Local Only)</button>
                            <button type="button" class="btn btn-secondary" id="clearApiKey">🗑️ Clear</button>
                        </div>
                        <p class="api-warning">⚠️ API key is stored locally in your browser only. Never commit keys to git.</p>
                    </div>
                </div>

                <button class="btn btn-primary btn-generate" id="generateBtn">
                    <span class="btn-icon">✨</span>
                    <span class="btn-text">Generate Code</span>
                </button>
            </section>

            <section class="result-section" id="resultSection" hidden>
                <div class="result-header">
                    <div class="result-tabs">
                        <button class="tab-btn active" data-tab="code">💻 Code</button>
                        <button class="tab-btn" data-tab="preview">👁️ Preview</button>
                        <button class="tab-btn" data-tab="colors" id="colorsTab" hidden>🎨 Colors</button>
                        <button class="tab-btn" data-tab="history">📜 History</button>
                        <button class="tab-btn" data-tab="api" id="apiTab">🔗 API</button>
                    </div>
                    <div class="result-actions">
                        <button class="btn btn-icon" id="copyBtn" title="Copy to Clipboard">📋</button>
                        <button class="btn btn-icon" id="downloadBtn" title="Download File">💾</button>
                        <button class="btn btn-icon" id="exportBtn" title="Export Options">📤</button>
                    </div>
                </div>

                <div class="result-content">
                    <div class="tab-panel active" id="codePanel">
                        <div class="code-header">
                            <span class="code-lang" id="codeLang">HTML</span>
                            <span class="code-stats" id="codeStats"></span>
                        </div>
                        <pre class="code-block"><code id="codeOutput"></code></pre>
                    </div>
                    
                    <div class="tab-panel" id="previewPanel">
                        <div class="preview-frame-container">
                            <iframe id="previewFrame" sandbox="allow-scripts"></iframe>
                        </div>
                    </div>
                    
                    <div class="tab-panel" id="colorsPanel">
                        <div class="colors-grid" id="colorsGrid"></div>
                    </div>

                    <div class="tab-panel" id="historyPanel">
                        <div class="history-header">
                            <h4>Recent Generations</h4>
                            <button class="btn btn-sm btn-secondary" id="clearHistoryBtn">🗑️ Clear</button>
                        </div>
                        <div class="history-list" id="historyList">
                            <p class="history-empty">No history yet. Generate some code to see it here! ✨</p>
                        </div>
                    </div>

                    <div class="tab-panel" id="apiPanel">
                        <div class="api-status-panel">
                            <h4>🔧 API Configuration</h4>
                            <div class="api-status" id="apiStatus">
                                <span class="api-status-icon">⚪</span>
                                <span class="api-status-text">No API configured</span>
                            </div>
                            <div class="api-info-list" id="apiInfoList">
                                <p>Use the <strong>Options</strong> section to configure an AI API for real screenshot-to-code conversion.</p>
                                <h5>Supported APIs:</h5>
                                <ul>
                                    <li><strong>OpenAI GPT-4 Vision</strong> - Best accuracy, requires paid API key</li>
                                    <li><strong>Anthropic Claude</strong> - Great results, requires paid API key</li>
                                    <li><strong>Ollama (Local)</strong> - Free, runs locally, requires Ollama installed</li>
                                </ul>
                                <div class="api-setup-steps">
                                    <h5>Quick Setup:</h5>
                                    <ol>
                                        <li>Select an API provider above</li>
                                        <li>Enter your API key (stored locally)</li>
                                        <li>Click <strong>Save Key</strong></li>
                                        <li>Upload a screenshot and generate!</li>
                                    </ol>
                                </div>
                                <div class="api-privacy-note">
                                    <strong>🔒 Privacy Note:</strong> Your API key is stored only in your browser's localStorage. Your images are sent directly to the configured API - we don't store them.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <footer class="footer">
            <p>Made with 💡 by <a href="https://github.com/Agent-Lumi">Lumi</a></p>
            <p class="footer-note">Note: This is a demo tool. For real AI-powered conversion, integrate with an API like OpenAI Vision or similar.</p>
        </footer>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay" hidden>
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Analyzing image...</p>
        </div>
    </div>

    <!-- Keyboard Shortcuts Modal -->
    <div class="modal" id="shortcutsModal" hidden>
        <div class="modal-content">
            <div class="modal-header">
                <h3>⌨️ Keyboard Shortcuts</h3>
                <button class="modal-close" id="closeModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="shortcut-row">
                    <kbd>Ctrl</kbd> + <kbd>V</kbd>
                    <span>Paste image from clipboard</span>
                </div>
                <div class="shortcut-row">
                    <kbd>Ctrl</kbd> + <kbd>O</kbd>
                    <span>Open file dialog</span>
                </div>
                <div class="shortcut-row">
                    <kbd>Ctrl</kbd> + <kbd>C</kbd>
                    <span>Copy generated code</span>
                </div>
                <div class="shortcut-row">
                    <kbd>Ctrl</kbd> + <kbd>S</kbd>
                    <span>Download code file</span>
                </div>
                <div class="shortcut-row">
                    <kbd>Ctrl</kbd> + <kbd>?</kbd>
                    <span>Show this help</span>
                </div>
                <div class="shortcut-row">
                    <kbd>Ctrl</kbd> + <kbd>E</kbd>
                    <span>Export options</span>
                </div>
                <div class="shortcut-row">
                    <kbd>Esc</kbd>
                    <span>Close modals / Reset</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Modal -->
    <div class="modal" id="exportModal" hidden>
        <div class="modal-content">
            <div class="modal-header">
                <h3>📤 Export Options</h3>
                <button class="modal-close" id="closeExportModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="export-options">
                    <button class="export-option" data-format="html">
                        <span class="export-icon">🌐</span>
                        <span class="export-title">HTML File</span>
                        <span class="export-desc">.html - Complete standalone file</span>
                    </button>
                    <button class="export-option" data-format="css">
                        <span class="export-icon">🎨</span>
                        <span class="export-title">CSS File</span>
                        <span class="export-desc">.css - Styles only</span>
                    </button>
                    <button class="export-option" data-format="js">
                        <span class="export-icon">📜</span>
                        <span class="export-title">JavaScript File</span>
                        <span class="export-desc">.js - Script only</span>
                    </button>
                    <button class="export-option" data-format="json">
                        <span class="export-icon">📋</span>
                        <span class="export-title">JSON Export</span>
                        <span class="export-desc">.json - Code + metadata</span>
                    </button>
                    <button class="export-option" data-format="zip">
                        <span class="export-icon">🗜️</span>
                        <span class="export-title">ZIP Archive</span>
                        <span class="export-desc">.zip - All files bundled</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Help Button -->
    <button class="help-btn" id="helpBtn" title="Keyboard Shortcuts (Ctrl+?)">?</button>

    <script src="app.js"></script>
</body>
</html>
